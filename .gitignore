# First ignore everything
*
!.gitignore

# Then whitelist wp-content directory
!/YJmpLrEKXkg2.com/
/YJmpLrEKXkg2.com/*
!/YJmpLrEKXkg2.com/wp-content/

# Then whitelist plugins and themes
/YJmpLrEKXkg2.com/wp-content/*
!/YJmpLrEKXkg2.com/wp-content/plugins/
!/YJmpLrEKXkg2.com/wp-content/themes/

# Ignore specific plugins and themes
/YJmpLrEKXkg2.com/wp-content/plugins/*
!/YJmpLrEKXkg2.com/wp-content/plugins/elementor/
!/YJmpLrEKXkg2.com/wp-content/plugins/royal-elementor-addons/

/YJmpLrEKXkg2.com/wp-content/themes/*
!/YJmpLrEKXkg2.com/wp-content/themes/hello-elementor/

# Ignore uploads and generated files
/YJmpLrEKXkg2.com/wp-content/uploads/
/YJmpLrEKXkg2.com/wp-content/cache/
/YJmpLrEKXkg2.com/wp-content/upgrade/
/YJmpLrEKXkg2.com/wp-content/backup-db/
/YJmpLrEKXkg2.com/wp-content/advanced-cache.php
/YJmpLrEKXkg2.com/wp-content/wp-cache-config.php
/YJmpLrEKXkg2.com/wp-content/debug.log

# Ignore core WordPress files
/YJmpLrEKXkg2.com/wp-admin/
/YJmpLrEKXkg2.com/wp-includes/
/YJmpLrEKXkg2.com/*.php
/YJmpLrEKXkg2.com/wp-*.php
/YJmpLrEKXkg2.com/xmlrpc.php
/YJmpLrEKXkg2.com/index.php

# System files
.DS_Store
Thumbs.db
*.log
*.sql
*.sqlite

# IDE files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Node modules
node_modules/

# Compiled files
*.com
*.class
*.dll
*.exe
*.o
*.so

# Packages
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Sensitive files
*.env
*.key
*.pem
wp-config.php